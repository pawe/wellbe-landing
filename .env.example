# Copy to .env and adjust. `docker compose up -d db` gives you the database below.

# The only variable with no default.
DATABASE_URL=postgres://wellbe:wellbe@localhost:5432/wellbe_landing

# Where to listen. Default: 0.0.0.0:8080
BIND=127.0.0.1:8080

# Used to build the confirmation links in outgoing mail, so it has to be the
# address people actually reach the site on. Default: http://$BIND
BASE_URL=http://localhost:8080

# Below this many confirmed signups the page shows no counter at all.
# Default: 25
COUNTER_THRESHOLD=25

# Set to 0 when a separate process drains the outbox. Default: on.
DRAIN_OUTBOX=1

RUST_LOG=wellbe_landing=debug,tower_http=info,sqlx=warn
